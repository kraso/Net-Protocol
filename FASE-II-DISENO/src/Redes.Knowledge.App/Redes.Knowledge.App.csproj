<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>Redes.Knowledge.App</RootNamespace>
    <AssemblyName>NetProtocol</AssemblyName>
    <Product>Net Protocol</Product>
    <Description>Net Protocol — Plataforma de referencia, exploración y simulación de redes</Description>
    <ApplicationIcon>Assets\NetProtocol.ico</ApplicationIcon>
    <Version>1.0.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Redes.Knowledge.Domain\Redes.Knowledge.Domain.csproj" />
    <ProjectReference Include="..\Redes.Knowledge.Infrastructure\Redes.Knowledge.Infrastructure.csproj" />
    <ProjectReference Include="..\Redes.Knowledge.Visualization\Redes.Knowledge.Visualization.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Datasets de la Fase I que viajan junto al ejecutable (modo instalado):
         la app los resuelve desde "datos/..." (RaizDatos en MainWindow).
         Se copian al output y, por tanto, al publicar e instalar. -->
    <None Include="..\..\..\FASE-03-INVENTARIO\F3-Protocolos.json"
          Link="datos\FASE-03-INVENTARIO\F3-Protocolos.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\FASE-04-PROFUNDIZACION\F4-Fichas-Prioritarias.json"
          Link="datos\FASE-04-PROFUNDIZACION\F4-Fichas-Prioritarias.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\FASE-04-PROFUNDIZACION\F4-Matriz-Encapsulacion.json"
          Link="datos\FASE-04-PROFUNDIZACION\F4-Matriz-Encapsulacion.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\FASE-05-MENSAJERIA\F5-Campos-PDU.json"
          Link="datos\FASE-05-MENSAJERIA\F5-Campos-PDU.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\FASE-06-SEGURIDAD\F6-Seguridad-Protocolos.json"
          Link="datos\FASE-06-SEGURIDAD\F6-Seguridad-Protocolos.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>