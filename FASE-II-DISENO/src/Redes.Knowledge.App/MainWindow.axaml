<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="820"
        x:Class="Redes.Knowledge.App.MainWindow"
        Title="Net Protocol"
        Width="1400" Height="820"
        FontFamily="{DynamicResource FuenteUi}"
        WindowDecorations="None">
  <Window.Styles>
    <!-- Botones de ventana propios: transparentes, en escala de grises sobre la barra,
         hover más claro; el de cerrar se resalta en rojo al pasar el ratón. -->
    <Style Selector="Button.WinBtn">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#E6FFFFFF" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.WinBtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#33FFFFFF" />
    </Style>
    <Style Selector="Button.WinBtn.CloseBtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#E81123" />
    </Style>
  </Window.Styles>
  <DockPanel>
    <!-- Barra de título Net Protocol: gradiente negro→blanco horizontal, cristalizado
         (transparencia parcial), predominio del negro y PERMANENTE (colores fijos,
         no dependen del tema claro/oscuro). El nombre y el logo aparecen UNA sola vez;
         los botones de ventana (— □ ✕) son propios. -->
    <Border DockPanel.Dock="Top" Height="44"
            Background="{DynamicResource PincelBarraTitulo}">
      <Grid Margin="14,0,0,0">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"
                    Background="Transparent"
                    PointerPressed="TitleBar_PointerPressed">
          <Image Width="26" Height="26" Stretch="Uniform"
                 Source="avares://NetProtocol/Assets/Logo_NetProtocol.png" />
          <TextBlock Text="Net Protocol" FontWeight="SemiBold" FontSize="16"
                     Foreground="#FFFFFFFF" VerticalAlignment="Center" />
        </StackPanel>
        <!-- Botones de ventana propios (SystemDecorations=None) -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                    VerticalAlignment="Top" Spacing="0">
          <Button Content="&#x2014;" Width="46" Height="44" Classes="WinBtn"
                  Click="Minimize_Click" />
          <Button Content="&#x25A1;" Width="46" Height="44" Classes="WinBtn"
                  Click="Maximize_Click" />
          <Button Content="&#x2715;" Width="46" Height="44" Classes="WinBtn CloseBtn"
                  Click="Close_Click" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Barra superior: búsqueda + filtros Familia/Estado + acciones globales.
         WrapPanel: si la ventana no da para una sola línea, los controles bajan de
         línea en vez de recortarse (nunca se oculta texto). -->
    <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" ItemSpacing="8" LineSpacing="6" Margin="8">
      <TextBox x:Name="SearchBox" Width="170" PlaceholderText="Buscar protocolo, RFC, puerto, campo…" />
      <Button x:Name="SearchButton" Content="Buscar" />
      <SelectableTextBlock Text="Familia:" VerticalAlignment="Center" />
      <ComboBox x:Name="FilterFamilia" Width="210" />
      <SelectableTextBlock Text="Estado:" VerticalAlignment="Center" />
      <ComboBox x:Name="FilterEstado" Width="210" />
      <Button x:Name="ThemeButton" Content="Tema claro/oscuro" />
      <SelectableTextBlock Text="Comparar con:" VerticalAlignment="Center" />
      <ComboBox x:Name="CompareTarget" Width="300" />
      <Button x:Name="CompareButton" Content="Comparar" />
      <Button x:Name="LegendButton" Content="Leyenda" />
    </WrapPanel>

    <!-- Barra de estado -->
    <SelectableTextBlock DockPanel.Dock="Bottom" x:Name="StatusText" Margin="10,6" TextWrapping="Wrap" />

    <!--
      Sidebar lateral: SOLO los grupos de familias ("dropdowns" de la navegación).
      - Filtro rápido para localizar familias/protocolos
      - Todos los paneles con anchura idéntica (fija) y altura uniforme (acordeón)
    -->
    <Border x:Name="Sidebar" DockPanel.Dock="Left" Width="360"
            BorderBrush="#334155" BorderThickness="0,0,1,0">
      <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Top" Spacing="6">
          <TextBox x:Name="NavFilter" PlaceholderText="Filtrar familias…" />
          <Border Height="1" Background="#334155" />
        </StackPanel>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="NavPanel" Spacing="6" />
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- Ficha de protocolo + diagramas de arquitectura (pila F4, grafo vecinos, wire format F5).
         IMPORTANTE: sin scroll horizontal (Disabled) para que el contenido tenga ancho finito
         y el texto ENVUELVA (TextWrapping real). Los diagramas anchos tienen su propio
         ScrollViewer horizontal (ver RenderDiagramas). -->
    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="14" Spacing="10">
        <SelectableTextBlock x:Name="DetailText" TextWrapping="Wrap" />
        <SelectableTextBlock x:Name="DiagramTitle" Text="Diagramas de arquitectura:" FontWeight="Bold" IsVisible="False" />
        <StackPanel x:Name="DiagramPanel" Spacing="14" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>