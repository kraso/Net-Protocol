<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="820"
        x:Class="Redes.Knowledge.App.MainWindow"
        Title="Net Protocol"
        Width="1400" Height="820"
        MinWidth="960" MinHeight="600"
        FontFamily="{DynamicResource FuenteUi}"
        WindowDecorations="None">
  <Window.Styles>
    <!-- Botones de ventana propios: transparentes, en escala de grises sobre la barra,
         hover más claro; el de cerrar se resalta en rojo al pasar el ratón. -->
    <Style Selector="Button.WinBtn">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#E6FFFFFF" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.WinBtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#33FFFFFF" />
    </Style>
    <Style Selector="Button.WinBtn.CloseBtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#E81123" />
    </Style>
    <!-- Botones de acción de la sidebar: réplica del diseño de los ComboBox superiores
         (mismo fondo y borde del tema) pero más estrechos (220 px) y con un matiz
         propio: el icono circular es BLANCO BRILLANTE permanente (sin color de acento)
         y el resaltado en hover queda neutro (borde claro del tema). -->
    <Style Selector="Button.SidebarAction">
      <Setter Property="Width" Value="220" />
      <Setter Property="Height" Value="34" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
    </Style>
    <Style Selector="Button.SidebarAction:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListLowBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
    </Style>
    <Style Selector="Button.SidebarAction:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListMediumBrush}" />
    </Style>
  </Window.Styles>
  <!-- Redimensión por borde con WindowDecorations=None: el marco del sistema no existe,
       así que la ventana NO redimensiona por defecto. Se añaden grips invisibles (bordes
       finos + esquinas) sobre el contenido que llaman a BeginResizeDrag; el zoom es una
       cosa distinta (Ctrl+Scroll → reflow de fuente). MinWidth/MinHeight (960×600) fija
       el límite inferior: la ventana nunca baja de ese tamaño. -->
  <Grid RowDefinitions="6,*,6" ColumnDefinitions="6,*,6">
    <DockPanel Grid.Row="1" Grid.Column="1">
    <!-- Barra de título Net Protocol: gradiente negro→blanco horizontal, cristalizado
         (transparencia parcial), predominio del negro y PERMANENTE (colores fijos,
         no dependen del tema claro/oscuro). El nombre y el logo aparecen UNA sola vez;
         los botones de ventana (— □ ✕) son propios. -->
    <Border DockPanel.Dock="Top" Height="44"
            Background="{DynamicResource PincelBarraTitulo}">
      <Grid Margin="14,0,0,0">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"
                    Background="Transparent"
                    PointerPressed="TitleBar_PointerPressed">
          <Image Width="26" Height="26" Stretch="Uniform"
                 Source="avares://NetProtocol/Assets/Logo_NetProtocol.png" />
          <TextBlock Text="Net Protocol" FontWeight="SemiBold" FontSize="16"
                     Foreground="#FFFFFFFF" VerticalAlignment="Center" />
        </StackPanel>
        <!-- Botones de ventana propios (SystemDecorations=None) -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                    VerticalAlignment="Top" Spacing="0">
          <Button Content="&#x2014;" Width="46" Height="44" Classes="WinBtn"
                  Click="Minimize_Click" />
          <Button Content="&#x25A1;" Width="46" Height="44" Classes="WinBtn"
                  Click="Maximize_Click" />
          <Button Content="&#x2715;" Width="46" Height="44" Classes="WinBtn CloseBtn"
                  Click="Close_Click" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Barra superior: búsqueda + filtros Familia/Estado + comparador.
         WrapPanel: si la ventana no da para una sola línea, los controles bajan de
         línea en vez de recortarse (nunca se oculta texto). -->
    <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" ItemSpacing="8" LineSpacing="6" Margin="8">
      <TextBox x:Name="SearchBox" Width="170" PlaceholderText="Buscar protocolo, RFC, puerto, campo…" />
      <Button x:Name="SearchButton" Content="Buscar" />
      <!-- Selector de protocolo: referencia permanente de en qué protocolo estamos y vía
           de navegación directa. Mismo patrón que la casilla "Comparar con:" (ancho fijo
           300 px y carrusel del nombre completo en el desplegable). -->
      <SelectableTextBlock Text="Protocolo:" VerticalAlignment="Center" />
      <ComboBox x:Name="ProtocolSelector" Width="300" />
      <!-- Comparador justo a la derecha del selector de protocolo (orden solicitado). -->
      <SelectableTextBlock Text="Comparar con:" VerticalAlignment="Center" />
      <ComboBox x:Name="CompareTarget" Width="300" />
      <Button x:Name="CompareButton" Content="Comparar"
              ToolTip.Tip="Compara el protocolo actual con otro del catálogo (referencia seleccionable). Pulsa '✕ Volver a la ficha' para salir."
              ToolTip.ShowDelay="600" />
      <!-- "Volver a la ficha": contextual, visible SOLO mientras la comparación está en
           pantalla. Restaura la ficha del protocolo previo (RenderFicha(_seleccionado)),
           que la comparación nunca modifica. Mismo patrón que "✕ Cerrar captura". -->
      <Button x:Name="VolverFichaButton" Content="✕ Volver a la ficha" IsVisible="False" />
      <SelectableTextBlock Text="Familia:" VerticalAlignment="Center" />
      <ComboBox x:Name="FilterFamilia" Width="210" />
      <SelectableTextBlock Text="Estado:" VerticalAlignment="Center" />
      <ComboBox x:Name="FilterEstado" Width="210" />
      <SelectableTextBlock Text="Exportar:" VerticalAlignment="Center" />
      <ComboBox x:Name="ExportFormat" Width="90" />
      <Button x:Name="ExportButton" Content="Exportar"
              ToolTip.Tip="Exporta los diagramas de la ficha actual (pila, grafo, cabecera) al formato elegido: SVG, PNG o PDF."
              ToolTip.ShowDelay="600" />
      <Button x:Name="AbrirCapturaButton" Content="Abrir captura"
              ToolTip.Tip="Abre una ventana del explorador para que selecciones el archivo .cap de captura de paquetes con PCAP/PCAPNG y luego muestra sus detalles en pantalla."
              ToolTip.ShowDelay="600" />
      <Button x:Name="MuestraButton" Content="Muestra de prueba"
              ToolTip.Tip="Genera una captura sintética determinista (muestras de los 28 protocolos con layout F5) en tu carpeta de capturas."
              ToolTip.ShowDelay="600" />
    </WrapPanel>

    <!-- Barra de estado -->
    <SelectableTextBlock DockPanel.Dock="Bottom" x:Name="StatusText" Margin="10,6" TextWrapping="Wrap" />

    <!--
      Sidebar lateral: SOLO los grupos de familias ("dropdowns" de la navegación).
      - Filtro rápido para localizar familias/protocolos
      - Todos los paneles con anchura idéntica (fija) y altura uniforme (acordeón)
      - En la parte inferior: Tema, Leyenda y Acerca de
    -->
    <Border x:Name="Sidebar" DockPanel.Dock="Left" Width="360"
            BorderBrush="#334155" BorderThickness="0,0,1,0">
      <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Top" Spacing="6">
          <TextBox x:Name="NavFilter" PlaceholderText="Filtrar familias…" />
          <Border Height="1" Background="#334155" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Spacing="6">
          <Border Height="1" Background="#334155" />
          <!-- Sección especial: botones con diseño "tipo desplegable" (mismo fondo/borde
               que los ComboBox de la barra superior) pero más estrechos y con matiz
               propio: icono circular BLANCO BRILLANTE (sin color de acento) + texto +
               chevrón tenue. Acerca de muestra el logotipo de la aplicación. -->
          <TextBlock Text="Acciones" FontSize="11" Opacity="0.6" Margin="4,2,0,2" />
          <Button x:Name="ThemeButton" Classes="SidebarAction">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Border Width="20" Height="20" CornerRadius="10" Background="#FFFFFFFF">
                <TextBlock Text="&#x263E;" FontSize="13" Foreground="#FF1C1C1C"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="Tema claro/oscuro" VerticalAlignment="Center" />
              <TextBlock Text="&#x25B8;" FontSize="10" Opacity="0.45" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="LegendButton" Classes="SidebarAction">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Border Width="20" Height="20" CornerRadius="10" Background="#FFFFFFFF">
                <TextBlock Text="&#x2261;" FontSize="13" Foreground="#FF1C1C1C"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="Leyenda" VerticalAlignment="Center" />
              <TextBlock Text="&#x25B8;" FontSize="10" Opacity="0.45" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="AboutButton" Classes="SidebarAction">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Border Width="22" Height="22" CornerRadius="11" Background="#FFFFFFFF"
                      Padding="3">
                <Image Source="avares://NetProtocol/Assets/Logo_NetProtocol.png"
                       Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="Acerca de" VerticalAlignment="Center" />
              <TextBlock Text="&#x25B8;" FontSize="10" Opacity="0.45" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="NavPanel" Spacing="6" />
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- Ficha de protocolo + diagramas de arquitectura (pila F4, grafo vecinos, wire format F5).
         IMPORTANTE: sin scroll horizontal (Disabled) para que el contenido tenga ancho finito
         y el texto ENVUELVA (TextWrapping real). Los diagramas anchos tienen su propio
         ScrollViewer horizontal (ver RenderDiagramas). -->
    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="14" Spacing="10">
        <SelectableTextBlock x:Name="DetailText" TextWrapping="Wrap" />
        <SelectableTextBlock x:Name="DiagramTitle" Text="Diagramas de arquitectura:" FontWeight="Bold" IsVisible="False" />
        <StackPanel x:Name="DiagramPanel" Spacing="14" />
        <!-- Vista de captura (D6-1): se muestra en lugar de la ficha mientras hay una captura.
             Lista de paquetes + detalle por capas con validación de layouts F5 (D6-2/L-004). -->
        <StackPanel x:Name="PanelCaptura" Spacing="8" IsVisible="False">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <SelectableTextBlock x:Name="ResumenCaptura" VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap" />
            <Button x:Name="CerrarCapturaButton" Content="✕ Cerrar captura" VerticalAlignment="Center" />
          </StackPanel>
          <ListBox x:Name="ListaPaquetes" Height="240" />
          <SelectableTextBlock x:Name="DetalleCaptura" TextWrapping="Wrap" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
    </DockPanel>

    <!-- Grips de redimensión (WindowDecorations=None): sin marco del sistema, el borde
         no redimensiona por defecto. Bordes finos (6 px) y esquinas (18 px) invisibles
         que capturan el botón izquierdo y llaman a BeginResizeDrag en el code-behind.
         El cursor cambia según la dirección. Independientes del zoom (Ctrl+Scroll). -->
    <Border Grid.Row="0" Grid.Column="1" Background="Transparent" Cursor="SizeNorthSouth"
            PointerPressed="Grip_N" />
    <Border Grid.Row="2" Grid.Column="1" Background="Transparent" Cursor="SizeNorthSouth"
            PointerPressed="Grip_S" />
    <Border Grid.Row="1" Grid.Column="0" Background="Transparent" Cursor="SizeWestEast"
            PointerPressed="Grip_W" />
    <Border Grid.Row="1" Grid.Column="2" Background="Transparent" Cursor="SizeWestEast"
            PointerPressed="Grip_E" />
    <Border Grid.Row="0" Grid.Column="0" Background="Transparent" Cursor="TopLeftCorner"
            PointerPressed="Grip_NW" />
    <Border Grid.Row="0" Grid.Column="2" Background="Transparent" Cursor="TopRightCorner"
            PointerPressed="Grip_NE" />
    <Border Grid.Row="2" Grid.Column="0" Background="Transparent" Cursor="BottomLeftCorner"
            PointerPressed="Grip_SW" />
    <Border Grid.Row="2" Grid.Column="2" Background="Transparent" Cursor="BottomRightCorner"
            PointerPressed="Grip_SE" />
  </Grid>
</Window>